CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# one of these two — anthropic wins if both are set.
# the game is free to run: a Featherless key + the default open model
# (Qwen/Qwen3-30B-A3B-Instruct-2507, ~3-4s/turn) is all it needs.
ANTHROPIC_API_KEY=
FEATHERLESS_API_KEY=
PERSONA_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# cold open (optional): your own handles — say hi to Maria on Telegram and
# the other two strangers find YOU, unprompted. These are the player's own
# pre-registered addresses (that's the consent mechanism); leave empty and
# the game waits for you in every room instead.
PLAYER_EMAIL=
PLAYER_DISCORD_ID=

# RUN_PACE=demo tightens every timer for a ~3-4 minute judge run
RUN_PACE=
