CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# one of these two — anthropic wins if both are set.
# the game is free to run: a Featherless key + the default open model
# (Qwen/Qwen3-30B-A3B-Instruct-2507, ~3-4s/turn) is all it needs.
ANTHROPIC_API_KEY=
FEATHERLESS_API_KEY=
PERSONA_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# a permanent invite to any server your Discord bot is in. Maria drops it
# in chat when Deke "gets impatient" — the conversation hands out its own
# doors, nobody reads a README. leave empty to skip the drop.
DISCORD_INVITE_URL=

# your Telegram bot's public link, like: TELEGRAM_BOT_URL=https://t.me/your_bot
# purely cosmetic: it's the first door listed on the live page at / — leave
# empty and that row just doesn't show.
TELEGRAM_BOT_URL=

# ---- solo testing (optional): put YOUR details on the lines below -------
# SOLO_TEST=1 lets ONE run — the first after boot — cold-open to the two
# handles below: say hi to Maria and the other two strangers find YOU,
# unprompted. Leave it EMPTY on anything public: these are your handles,
# and the first stranger's run would land in your inbox. Nothing is lost
# without it — when a room asks a player for their email in chat and they
# answer, Priya cold-opens to that address instead.
SOLO_TEST=
#
# the email you read on your phone, like:  PLAYER_EMAIL=yourname@gmail.com
PLAYER_EMAIL=
# your Discord USER ID — a long number, not your username. find it:
# Discord > Settings > Advanced > Developer Mode ON, then tap/right-click
# your own profile > Copy User ID.  like:  PLAYER_DISCORD_ID=849302876543210987
PLAYER_DISCORD_ID=

# demo pacing: set  RUN_PACE=demo  for a tight ~3-4 minute judge run
RUN_PACE=

# crowd control: how many runs may be live at once, and how many persona
# calls may be in flight across all of them (open-model endpoints answer a
# few at a time; past that everyone queues instead of erroring).
MAX_SESSIONS=12
MODEL_SLOTS=4
