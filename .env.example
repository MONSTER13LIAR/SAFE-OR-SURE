CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# one of these two — anthropic wins if both are set.
# the game is free to run: a Featherless key + the default open model
# (Qwen/Qwen3-30B-A3B-Instruct-2507, ~3-4s/turn) is all it needs.
ANTHROPIC_API_KEY=
FEATHERLESS_API_KEY=
PERSONA_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# a permanent invite to any server your Discord bot is in. Maria drops it
# in chat when Deke "gets impatient" — the conversation hands out its own
# doors, nobody reads a README. leave empty to skip the drop.
DISCORD_INVITE_URL=

# ---- cold open (optional): put YOUR details on the two lines below ------
# Say hi to Maria on Telegram and the other two strangers find YOU,
# unprompted. These are the player's own pre-registered addresses (that's
# the consent mechanism); leave empty and every room waits for you instead.
# Strangers don't need any of this: when Maria asks for their email in
# chat and they answer, Priya cold-opens to that address instead.
#
# the email you read on your phone, like:  PLAYER_EMAIL=yourname@gmail.com
PLAYER_EMAIL=
# your Discord USER ID — a long number, not your username. find it:
# Discord > Settings > Advanced > Developer Mode ON, then tap/right-click
# your own profile > Copy User ID.  like:  PLAYER_DISCORD_ID=849302876543210987
PLAYER_DISCORD_ID=

# demo pacing: set  RUN_PACE=demo  for a tight ~3-4 minute judge run
RUN_PACE=
